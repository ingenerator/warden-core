{
  "name": "ingenerator/warden-core",
  "type": "library",
  "description": "Framework-and-driver-independent authentication and authorization package",
  "keywords": [
    "web",
    "auth",
    "acl"
  ],
  "homepage": "https://github.com/ingenerator/warden-core",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Andrew Coulton",
      "email": "andrew@ingenerator.com",
      "homepage": "https://ingenerator.com"
    },
    {
      "name": "Craig Gosman",
      "email": "craig@ingenerator.com",
      "homepage": "https://ingenerator.com"
    }
  ],
  "require": {
    "egulias/email-validator": "^4.0.0",
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0 ",
    "symfony/validator": "^6.4.21 || ^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6.23"
  },
  "conflict": {
    "symfony/translation-contracts": " < 3.5.1"
  },
  "autoload": {
    "psr-4": {
      "Ingenerator\\Warden\\Core\\": "src/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  }
}
